{
    "oradaz_version": "3.0.08.24",
    "schema_version": "3.0.08.24",
    "services": [
        {
            "name": "graph",
            "description": "Microsoft Graph",
            "scopes": [
                "offline_access",
                "https://graph.microsoft.com/.default"
            ],
            "mandatory_auth": true,
            "url_scheme": "https://graph.microsoft.com/[API_VERSION]/[URI][PARAMS]",
            "default_api_behavior": {
                "value_field": "value",
                "next_link_field": "@odata.nextLink",
                "success_http_code": "200",
                "error_code": "error/code",
                "error_message": "error/message"
            },
            "default_parameters": [
                {
                    "name": "[API_VERSION]",
                    "value": "v1.0"
                },
                {
                    "name": "[PARAMS]",
                    "value": ""
                }
            ],
            "apis": [
            ]
        }
    ]
}
